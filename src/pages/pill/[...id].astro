---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz';
import SelectToggle from '../../components/SelectToggle';
import { allPills } from '../../lib/content';
import {
  SECTION_META,
  PROJECT_META,
  sectionAccent,
  formatDate,
  url,
} from '../../lib/site';

export async function getStaticPaths() {
  const pills = await allPills();
  return pills.map((pill, i) => ({
    params: { id: pill.id },
    props: {
      pill,
      newer: pills[i - 1] ?? null,
      older: pills[i + 1] ?? null,
    },
  }));
}

const { pill, newer, older } = Astro.props;
const { data } = pill;
const { Content } = await render(pill);
const meta = SECTION_META[data.section];
const accent = sectionAccent(data.section);
---

<Base title={data.title} description={data.tldr}>
  <article class="mx-auto max-w-5xl px-5">
    <header class="pt-12 pb-8 max-w-3xl">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[12.5px] mb-4">
        <a
          href={url(`/seccion/${data.section}`)}
          class="inline-flex items-center gap-1.5 font-medium"
          style={`color: ${accent}`}
        >
          <span class="w-1.5 h-1.5 rounded-full" style={`background: ${accent}`} aria-hidden="true"
          ></span>
          {meta.name}
        </a>
        <span class="faint">{formatDate(data.date)}</span>
        <span class="faint">· {data.readingMinutes} min de lectura</span>
        {
          data.depth === 'analisis' && (
            <span
              class="px-1.5 py-0.5 rounded font-medium"
              style="background: var(--bg-sunken); color: var(--text-muted)"
            >
              Análisis
            </span>
          )
        }
      </div>

      <h1 class="text-[clamp(1.7rem,4vw,2.35rem)] font-semibold tracking-tight leading-[1.18]">
        {data.title}
      </h1>

      <p class="mt-4 text-[17px] leading-relaxed muted">{data.tldr}</p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <SelectToggle
          client:idle
          variant="full"
          id={pill.id}
          title={data.title}
          section={data.section}
          sourceUrl={data.source.url}
        />
        <a
          href={data.source.url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-[13.5px] font-medium"
          style="border: 1px solid var(--border-strong); color: var(--text)"
        >
          Fuente original
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M8 7h9v9"></path>
          </svg>
        </a>
      </div>

      <p class="mt-3 text-[12.5px] faint">
        {data.source.author} · {data.source.platform}
        {data.source.publishedAt && ` · publicado el ${formatDate(data.source.publishedAt)}`}
      </p>
    </header>

    <div class="grid lg:grid-cols-[minmax(0,1fr)_260px] gap-x-12 gap-y-10 pb-16">
      <div class="min-w-0">
        <div class="prose">
          <Content />
        </div>

        {
          data.apply.length > 0 && (
            <section class="mt-12 rounded-xl p-6" style="background: var(--bg-sunken); border: 1px solid var(--border)">
              <h2 class="text-[13px] uppercase tracking-wide faint mb-4">Aplícalo</h2>
              <ol class="space-y-3">
                {data.apply.map((step, i) => (
                  <li class="flex gap-3 text-[14.5px] leading-relaxed">
                    <span
                      class="shrink-0 grid place-items-center w-5 h-5 rounded-md text-[11px] font-semibold mt-0.5"
                      style={`background: ${accent}; color: var(--bg-raised)`}
                    >
                      {i + 1}
                    </span>
                    <span>{step}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          data.quiz.length > 0 && (
            <section class="mt-10">
              <h2 class="text-[13px] uppercase tracking-wide faint mb-4">
                Compruébalo antes de aplicarlo
              </h2>
              <Quiz client:visible pillId={pill.id} questions={data.quiz} />
            </section>
          )
        }

        <nav class="mt-14 pt-8 border-t grid gap-3 sm:grid-cols-2" style="border-color: var(--border)">
          {
            older ? (
              <a
                href={url(`/pill/${older.id}`)}
                class="rounded-lg p-4 surface hover:border-[var(--border-strong)] transition-colors"
              >
                <span class="block text-[12px] faint mb-1">← Anterior</span>
                <span class="block text-[14px] font-medium leading-snug">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a
                href={url(`/pill/${newer.id}`)}
                class="rounded-lg p-4 surface hover:border-[var(--border-strong)] transition-colors sm:text-right"
              >
                <span class="block text-[12px] faint mb-1">Siguiente →</span>
                <span class="block text-[14px] font-medium leading-snug">{newer.data.title}</span>
              </a>
            )
          }
        </nav>
      </div>

      <aside class="space-y-8 lg:sticky lg:top-20 lg:self-start">
        {
          data.glossary.length > 0 && (
            <section>
              <h2 class="text-[12px] uppercase tracking-wide faint mb-3">Jerga de este artículo</h2>
              <dl class="space-y-3">
                {data.glossary.map((g) => (
                  <div>
                    <dt class="text-[13.5px] font-semibold font-mono">{g.term}</dt>
                    <dd class="text-[13px] leading-relaxed muted mt-0.5">{g.definition}</dd>
                  </div>
                ))}
              </dl>
              <a href={url('/glosario')} class="inline-block mt-3 text-[12.5px] link">
                Glosario completo →
              </a>
            </section>
          )
        }

        {
          data.projects.length > 0 && (
            <section>
              <h2 class="text-[12px] uppercase tracking-wide faint mb-3">Aplica a</h2>
              <ul class="space-y-2">
                {data.projects.map((p) => (
                  <li>
                    <a
                      href={url(`/proyectos#${p}`)}
                      class="block rounded-lg px-3 py-2 text-[13px] font-medium surface hover:border-[var(--border-strong)] transition-colors"
                    >
                      {PROJECT_META[p].name}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          data.tags.length > 0 && (
            <section>
              <h2 class="text-[12px] uppercase tracking-wide faint mb-3">Etiquetas</h2>
              <ul class="flex flex-wrap gap-1.5">
                {data.tags.map((t) => (
                  <li
                    class="px-2 py-0.5 rounded text-[12px] faint"
                    style="background: var(--bg-sunken)"
                  >
                    {t}
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>
  </article>
</Base>
