---
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allGuides } from '../../lib/content';
import { PROJECT_META, formatDate, url, SITE } from '../../lib/site';

export async function getStaticPaths() {
  const guides = await allGuides();
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const project = PROJECT_META[guide.data.project];

const sources = (
  await Promise.all(guide.data.pills.map((ref) => getEntry('pills', ref.id)))
).filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Base title={guide.data.title} description={guide.data.summary}>
  <article class="mx-auto max-w-3xl px-5">
    <header class="pt-14 pb-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[12.5px] mb-4">
        <span class="font-medium" style="color: var(--accent)">{project.name}</span>
        <span class="faint">{formatDate(guide.data.date)}</span>
        {
          guide.data.issue && (
            <a
              class="faint hover:underline"
              href={`https://github.com/${SITE.repo}/issues/${guide.data.issue}`}
              rel="noopener"
            >
              · issue #{guide.data.issue}
            </a>
          )
        }
      </div>
      <h1 class="text-[clamp(1.7rem,4vw,2.35rem)] font-semibold tracking-tight leading-[1.18]">
        {guide.data.title}
      </h1>
      <p class="mt-4 text-[17px] leading-relaxed muted">{guide.data.summary}</p>
    </header>

    {
      sources.length > 0 && (
        <section class="mb-10 rounded-xl p-5" style="background: var(--bg-sunken); border: 1px solid var(--border)">
          <h2 class="text-[12px] uppercase tracking-wide faint mb-3">Construida a partir de</h2>
          <ul class="space-y-1.5">
            {sources.map((pill) => (
              <li class="text-[14px]">
                <a href={url(`/pill/${pill.id}`)} class="link">
                  {pill.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="prose pb-20">
      <Content />
    </div>

    <div class="pb-16">
      <a href={url('/guias')} class="text-[13.5px] link">← Todas las guías</a>
    </div>
  </article>
</Base>
