---
import Base from '../../layouts/Base.astro';
import { allGuides } from '../../lib/content';
import { PROJECT_META, formatDate, url, SITE } from '../../lib/site';

const guides = await allGuides();
---

<Base
  title="Guías de aplicación"
  description="Guías interactivas generadas a partir de las piezas que has seleccionado."
>
  <div class="mx-auto max-w-3xl px-5">
    <header class="pt-14 pb-8">
      <h1 class="text-[clamp(1.8rem,4vw,2.4rem)] font-semibold tracking-tight">
        Guías de aplicación
      </h1>
      <p class="mt-3 text-[16.5px] leading-relaxed muted">
        Cada guía combina varias piezas y las baja a un proyecto concreto: plan de implementación,
        decisiones de diseño y examen final.
      </p>
    </header>

    <div class="pb-20">
      {
        guides.length === 0 ? (
          <div class="rounded-xl p-8 surface">
            <p class="text-[15px] font-medium mb-2">Todavía no has pedido ninguna guía</p>
            <p class="muted text-[14px] leading-relaxed mb-5">
              Marca piezas con el icono de marcador mientras lees, ve a tu selección y pide la guía.
              Se abre un issue en el repositorio y la siguiente sesión diaria la escribe y la publica
              aquí.
            </p>
            <a
              href={url('/seleccion')}
              class="inline-block rounded-lg px-4 py-2 text-[13.5px] font-medium"
              style="background: var(--accent); color: var(--bg-raised)"
            >
              Ver mi selección
            </a>
          </div>
        ) : (
          <ul class="space-y-3">
            {guides.map((guide) => (
              <li>
                <a
                  href={url(`/guias/${guide.id}`)}
                  class="block rounded-xl p-5 surface hover:border-[var(--border-strong)] transition-colors"
                >
                  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[12px] mb-2">
                    <span class="font-medium" style="color: var(--accent)">
                      {PROJECT_META[guide.data.project].name}
                    </span>
                    <span class="faint">{formatDate(guide.data.date)}</span>
                    <span class="faint">· {guide.data.pills.length} piezas</span>
                  </div>
                  <h2 class="text-[16.5px] font-semibold leading-snug tracking-tight mb-1.5">
                    {guide.data.title}
                  </h2>
                  <p class="text-[14px] leading-relaxed muted">{guide.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Base>
