---
import '../styles/global.css';
import { SITE, url, SECTIONS, SECTION_META } from '../lib/site';
import SelectionTray from '../components/SelectionTray';

interface Props {
  title?: string;
  description?: string;
  /** Oculta la barra flotante de selección (p. ej. en la propia página /seleccion). */
  hideTray?: boolean;
}

const { title, description = SITE.description, hideTray = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === url(href).replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>"
    />
    <script is:inline>
      // Antes de pintar, para no parpadear en blanco al cargar en modo oscuro.
      try {
        const saved = localStorage.getItem('asd:theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:px-3 focus:py-2 focus:rounded-lg surface"
      >Saltar al contenido</a
    >

    <header
      class="sticky top-0 z-30 backdrop-blur-md border-b"
      style="background: color-mix(in oklab, var(--bg) 82%, transparent); border-color: var(--border);"
    >
      <div class="mx-auto max-w-5xl px-5">
        <div class="flex items-center gap-4 h-14">
          <a href={url('/')} class="font-semibold tracking-tight text-[15px] shrink-0">
            <span style="color: var(--accent)">⚡</span> AI Systems <span class="faint">Daily</span>
          </a>

          <nav class="hidden md:flex items-center gap-1 text-[13px] ml-2" aria-label="Principal">
            {
              SECTIONS.map((s) => (
                <a
                  href={url(`/seccion/${s}`)}
                  class="px-2.5 py-1.5 rounded-md transition-colors hover:bg-[var(--bg-sunken)]"
                  style={`color: ${isActive(`/seccion/${s}`) ? 'var(--text)' : 'var(--text-muted)'}`}
                >
                  {SECTION_META[s].name}
                </a>
              ))
            }
          </nav>

          <div class="ml-auto flex items-center gap-1 text-[13px]">
            <a
              href={url('/guias')}
              class="px-2.5 py-1.5 rounded-md muted hover:bg-[var(--bg-sunken)] transition-colors"
              >Guías</a
            >
            <a
              href={url('/archivo')}
              class="px-2.5 py-1.5 rounded-md muted hover:bg-[var(--bg-sunken)] transition-colors"
              >Archivo</a
            >
            <a
              href={url('/glosario')}
              class="hidden sm:inline px-2.5 py-1.5 rounded-md muted hover:bg-[var(--bg-sunken)] transition-colors"
              >Glosario</a
            >
            <button
              id="theme-toggle"
              type="button"
              aria-label="Cambiar tema"
              class="ml-1 w-8 h-8 grid place-items-center rounded-md muted hover:bg-[var(--bg-sunken)] transition-colors"
            >
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path
                  d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
                  class="hidden dark-only"
                  style="display: none"></path>
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                ></path>
              </svg>
            </button>
          </div>
        </div>

        <nav class="md:hidden flex gap-1 pb-2 -mt-1 overflow-x-auto text-[12px]" aria-label="Secciones">
          {
            SECTIONS.map((s) => (
              <a
                href={url(`/seccion/${s}`)}
                class="shrink-0 px-2 py-1 rounded muted hover:bg-[var(--bg-sunken)]"
              >
                {SECTION_META[s].name}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="contenido" class="flex-1 w-full">
      <slot />
    </main>

    <footer class="mt-20 border-t" style="border-color: var(--border)">
      <div
        class="mx-auto max-w-5xl px-5 py-8 text-[13px] faint flex flex-wrap gap-x-6 gap-y-2 items-center"
      >
        <span>{SITE.title} — generada cada mañana antes de las 8:00 ({SITE.timezone}).</span>
        <a class="link" href={`https://github.com/${SITE.repo}`} rel="noopener">Repositorio</a>
        <a class="link" href={url('/proyectos')}>Proyectos</a>
        <a class="link" href={url('/rss.xml')}>RSS</a>
      </div>
    </footer>

    {!hideTray && <SelectionTray basePath={import.meta.env.BASE_URL} client:idle />}

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('asd:theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
